# Copy to .env.local for local development, and add the same keys in
# Vercel → Project → Settings → Environment Variables.

# Contact form (https://resend.com) — required for "Send inquiry" to work.
RESEND_API_KEY=
CONTACT_EMAIL=muneezafatima567@gmail.com

# Site chatbot (https://platform.claude.com) — optional. Without it the robot
# answers from built-in replies; with it, answers come from Claude AI.
# Set a monthly spend limit on the key in the Claude Console.
ANTHROPIC_API_KEY=

# Your custom domain, e.g. https://muneezafatima.com (no trailing slash).
# Optional on Vercel: if unset, the project's production URL is used for
# canonical links, the sitemap and social share previews.
NEXT_PUBLIC_SITE_URL=
